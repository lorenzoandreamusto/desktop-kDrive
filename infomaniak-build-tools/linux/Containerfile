# Local Linux AppImage build image.
#
# The published image already provides the complete toolchain (Conan, the Qt
# Online Installer, linuxdeploy and its plugins, appimagetool and sentry-cli).
# This layer only adds the system development packages required by the current
# sources that are missing from the published image:
#   - libfuse3-dev: pkg-config metadata and headers for BUILD_LINUX_VFS (Lite Sync)
#   - libc-ares-dev: system c-ares required by the Sentry Conan recipe
#
# Build it with infomaniak-build-tools/linux/build-podman-image.sh and run the
# build with build-release-via-podman.sh.

ARG BASE_IMAGE=ghcr.io/infomaniak/kdrive-desktop-linux:latest
FROM ${BASE_IMAGE}

# 'apt-install' is provided by the base image: it runs apt update/install and
# cleans the package lists afterwards.
RUN apt-install libfuse3-dev libc-ares-dev
